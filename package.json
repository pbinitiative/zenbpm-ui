{
  "name": "zenbpm-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm generate:api && node scripts/generate-i18n-types.mjs",
    "predev": "pnpm prebuild",
    "dev": "vite",
    "dev:mocks": "pnpm dev --mode mocks",
    "dev:live": "pnpm dev --mode live",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && pnpm typecheck:e2e:live",
    "typecheck:e2e:live": "tsc --noEmit -p tsconfig.e2e-live.json",
    "check": "pnpm lint && pnpm typecheck",
    "preview": "vite preview",
    "generate:validation-schemas": "node scripts/generate-openapi-validation-schemas.mjs",
    "generate:api": "pnpm generate:validation-schemas && orval",
    "generate:i18n-types": "node scripts/generate-i18n-types.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:live:ui": "playwright test --ui --config=playwright.live.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@bpmn-io/form-js": "^2.1.1",
    "@bpmn-io/properties-panel": "^3.58.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/xml": "^1.0.6",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "bpmn-js": "^18.31.1",
    "bpmn-js-properties-panel": "^5.65.3",
    "dmn-js": "^17.11.0",
    "dmn-js-properties-panel": "^3.13.0",
    "dotenv": "^18.0.9",
    "i18next": "^26.5.8",
    "json-bigint": "^1.0.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.6",
    "react-router-dom": "^7.18.4",
    "@pbinitiative/zenbpm-bpmn-moddle": "0.3.1",
    "@pbinitiative/zenbpm-js-properties-panel": "0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "^2.71.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "openapi3-ts": "^4.6.2",
    "orval": "^8.44.0",
    "storybook": "^10.6.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "overrides": {
      "preact": "10.15.1"
    }
  }
}
