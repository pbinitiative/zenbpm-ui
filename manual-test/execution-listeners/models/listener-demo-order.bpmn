<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_listener-demo-order" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="listener-demo-order" name="Listener demo: order" isExecutable="true">
    <bpmn:startEvent id="OrderReceived" name="Order received">
      <bpmn:extensionElements>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="end" type="listener-demo-started" retries="3" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="OrderReceived" targetRef="ShipOrder" />
    <bpmn:serviceTask id="ShipOrder" name="Ship order">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="listener-demo-ship" />
        <zenbpm:taskHeaders>
          <zenbpm:header key="carrier" value="post" />
        </zenbpm:taskHeaders>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="listener-demo-reserve" />
          <zenbpm:executionListener eventType="start" type="listener-demo-credit" />
          <zenbpm:executionListener eventType="end" type="listener-demo-notify" retries="2" />
          <zenbpm:executionListener eventType="end" type="listener-demo-archive" />
        </zenbpm:executionListeners>
        <zenbpm:ioMapping>
          <zenbpm:input source="=orderId" target="shipmentOf" />
          <zenbpm:output source="=reserved" target="stockReserved" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="ShippingFailed" name="Shipping failed" attachedToRef="ShipOrder">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ShippingFailed_definition" errorRef="Error_shipping" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ShipOrder" targetRef="ConfirmDelivery" />
    <bpmn:userTask id="ConfirmDelivery" name="Confirm delivery">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="listener-demo-confirm" />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="listener-demo-prepare" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ConfirmDelivery" targetRef="OrderDelivered" />
    <bpmn:endEvent id="OrderDelivered" name="Order delivered">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ShippingFailed" targetRef="OrderNotShipped" />
    <bpmn:endEvent id="OrderNotShipped" name="Order not shipped">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:error id="Error_shipping" name="Shipping failed" errorCode="SHIPPING_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="listener-demo-order">
      <bpmndi:BPMNShape id="OrderReceived_di" bpmnElement="OrderReceived">
        <dc:Bounds x="160" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShipOrder_di" bpmnElement="ShipOrder">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConfirmDelivery_di" bpmnElement="ConfirmDelivery">
        <dc:Bounds x="416" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderDelivered_di" bpmnElement="OrderDelivered">
        <dc:Bounds x="576" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderNotShipped_di" bpmnElement="OrderNotShipped">
        <dc:Bounds x="448" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShippingFailed_di" bpmnElement="ShippingFailed">
        <dc:Bounds x="318" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="516" y="120" />
        <di:waypoint x="576" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="336" y="178" />
        <di:waypoint x="336" y="240" />
        <di:waypoint x="448" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
