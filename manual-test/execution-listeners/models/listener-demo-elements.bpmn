<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_listener-demo-elements" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="listener-demo-elements" name="Listener demo: every element" isExecutable="true">
    <bpmn:startEvent id="InvoiceDue" name="Invoice due">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="InvoiceDue" targetRef="SendInvoice" />
    <bpmn:sendTask id="SendInvoice" name="Send invoice">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="listener-demo-invoice" />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="listener-demo-invoice-before" />
          <zenbpm:executionListener eventType="end" type="listener-demo-invoice-after" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SendInvoice" targetRef="RateCustomer" />
    <bpmn:businessRuleTask id="RateCustomer" name="Rate customer">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="listener-demo-rating" />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="listener-demo-rating-before" />
          <zenbpm:executionListener eventType="end" type="listener-demo-rating-after" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="RateCustomer" targetRef="InvoiceAnnounced" />
    <bpmn:intermediateThrowEvent id="InvoiceAnnounced" name="Invoice announced">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="listener-demo-announce" />
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="listener-demo-announce-before" />
          <zenbpm:executionListener eventType="end" type="listener-demo-announce-after" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="InvoiceAnnounced_definition" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="InvoiceAnnounced" targetRef="InvoiceHandled" />
    <bpmn:endEvent id="InvoiceHandled" name="Invoice handled">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="listener-demo-elements">
      <bpmndi:BPMNShape id="InvoiceDue_di" bpmnElement="InvoiceDue">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendInvoice_di" bpmnElement="SendInvoice">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RateCustomer_di" bpmnElement="RateCustomer">
        <dc:Bounds x="416" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InvoiceAnnounced_di" bpmnElement="InvoiceAnnounced">
        <dc:Bounds x="576" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InvoiceHandled_di" bpmnElement="InvoiceHandled">
        <dc:Bounds x="672" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="516" y="120" />
        <di:waypoint x="546" y="120" />
        <di:waypoint x="546" y="98" />
        <di:waypoint x="576" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="612" y="98" />
        <di:waypoint x="672" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
