<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_listener-demo-fee" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="listener-demo-fee" name="Listener demo: fee" isExecutable="true">
    <bpmn:startEvent id="FeeDue" name="Fee due">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="FeeDue" targetRef="ChargeFee" />
    <bpmn:serviceTask id="ChargeFee" name="Charge fee">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="listener-demo-fee" />
        <zenbpm:ioMapping>
          <zenbpm:input source="=matches(orderId, pattern, flags)" target="isAnOrder" />
        </zenbpm:ioMapping>
        <zenbpm:executionListeners>
          <zenbpm:executionListener eventType="start" type="listener-demo-fee-before" />
        </zenbpm:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ChargeFee" targetRef="FeeCharged" />
    <bpmn:endEvent id="FeeCharged" name="Fee charged">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="listener-demo-fee">
      <bpmndi:BPMNShape id="FeeDue_di" bpmnElement="FeeDue">
        <dc:Bounds x="160" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="158" y="145" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ChargeFee_di" bpmnElement="ChargeFee">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FeeCharged_di" bpmnElement="FeeCharged">
        <dc:Bounds x="416" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="404" y="145" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
